  "item": [
    {
      "name": "1 - Health checks",
      "item": [
        {
          "name": "Barramento saudável",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{barramentoUrl}}/health",
            "description": "Confirma que o barramento está acessível na porta 10000."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const resposta = pm.response.json();",
                  "pm.test('Barramento informa status ok', function () {",
                  "    pm.expect(resposta.servico).to.eql('barramento');",
                  "    pm.expect(resposta.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
